# --- Discord OAuth2 (portail développeur Discord -> OAuth2 -> General) ---
DISCORD_CLIENT_ID=colle_ton_client_id_ici
DISCORD_CLIENT_SECRET=colle_ton_client_secret_ici

# --- NextAuth (obligatoire) ---
# Génère une valeur aléatoire avec : openssl rand -base64 32
NEXTAUTH_SECRET=colle_une_valeur_aleatoire_ici
# En local : http://localhost:3000  |  Sur Vercel : mets l'URL de ton déploiement (ou laisse vide, Vercel la déduit)
NEXTAUTH_URL=http://localhost:3000

# --- Base de données partagée avec le bot (Supabase -> Project Settings -> Database -> Connection string, mode URI) ---
DATABASE_URL=postgresql://postgres:TON_MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres
